{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "jsx": "react-jsx",
        "strict": true,
        "moduleResolution": "Bundler",
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["assets/*"]
        }
    },
    "include": [
        "assets/**/*.ts",
        "assets/**/*.tsx",
        "assets/**/*.d.ts"
    ]
}
