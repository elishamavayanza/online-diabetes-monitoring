{% extends 'base.html.twig' %}

{% block title %}Accès retiré{% endblock %}

{% block body %}
    {% apply inline_css(source('@styles/email.css')) %}
        <div class="email-wrapper">
            <div class="email-content">
                <div class="email-header">
                    <img src="{{ logo_cid }}" alt="OnlineDIAB" class="logo">
                </div>
                <div class="email-body">
                    <h2>Votre accès a été retiré</h2>
                    <p>Bonjour,</p>
                    <p>
                        Votre accès au dossier du patient
                        <strong>{{ invitation.patient.fullName }}</strong> a été retiré
                        par l'organisation <strong>{{ invitation.organization.name }}</strong>.
                    </p>
                    <p>
                        Vous ne pouvez plus consulter ni modifier le dossier de ce patient.
                    </p>
                    <div class="note">
                        <p>Si vous pensez qu'il s'agit d'une erreur, contactez l'organisation qui a émis l'invitation.</p>
                    </div>
                </div>
                <div class="email-footer">
                    <p>&copy; {{ "now"|date("Y") }} OnlineDIAB. Tous droits réservés.</p>
                    <p><a href="https://www.onlinediab.com">www.onlinediab.com</a></p>
                </div>
            </div>
        </div>
    {% endapply %}
{% endblock %}