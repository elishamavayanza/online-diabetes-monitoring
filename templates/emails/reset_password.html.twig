{% extends 'base.html.twig' %}

{% block title %}Réinitialisation de votre mot de passe{% endblock %}

{% block body %}
    {# On inline le CSS du fichier compilé @styles/.css #}
    {% apply inline_css(source('@styles/email.css')) %}
        <div class="email-wrapper">
            <div class="email-content">
                <!-- En-tête avec logo -->
                <div class="email-header">
                    <img src="{{ logo_cid }}" alt="OnlineDIAB" class="logo">
                </div>

                <!-- Corps -->
                <div class="email-body">
                    <h2>Réinitialisation de mot de passe</h2>
                    <p>Bonjour,</p>
                    <p>
                        Vous avez demandé la réinitialisation du mot de passe associé à votre compte.
                        Pour définir un nouveau mot de passe, veuillez cliquer sur le bouton ci‑dessous :
                    </p>

                    <div class="btn-container">
                        <a href="{{ resetUrl }}" class="btn-reset" target="_blank">
                            Réinitialiser mon mot de passe
                        </a>
                    </div>

                    <p>
                        Ce lien est valide pour une durée de <strong>1 heure</strong>. Passé ce délai,
                        vous devrez refaire une demande.
                    </p>

                    <div class="note">
                        <p>
                            Si vous n’avez pas demandé cette modification, vous pouvez ignorer cet e‑mail
                            en toute sécurité. Votre mot de passe actuel restera inchangé.
                        </p>
                    </div>
                </div>

                <!-- Pied de page -->
                <div class="email-footer">
                    <p>&copy; {{ "now"|date("Y") }} OnlineDIAB. Tous droits réservés.</p>
                    <p><a href="https://www.onlinediab.com">www.onlinediab.com</a></p>
                    <div class="footer-links">
                        <a href="#">Nous contacter</a>
                        <span>|</span>
                        <a href="#">Se désabonner</a>
                    </div>
                </div>
            </div>
        </div>
    {% endapply %}
{% endblock %}
