<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ systemName|default('OnlineDIAB') }}{% endblock %}</title>
    <link rel="icon" type="image/svg+xml" href="{{ logoUrl|default(asset('images/logo.png')) }}">
    {# Applique le thème (clair/sombre) AVANT le rendu pour éviter le flash #}
    <script>
        (function () {
            try {
                var t = localStorage.getItem('diabcare-theme');
                if (t !== 'light' && t !== 'dark') {
                    t = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
                }
                document.documentElement.setAttribute('data-theme', t);
            } catch (e) { /* silencieux */ }
        })();
    </script>
    {# On charge le CSS via <link> pour les homepage web #}
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('build/app.css') }}">
{#        <link rel="stylesheet" href="{{ asset('styles/reset_password_form.css') }}">#}
    {% endblock %}
</head>
<body>
{% block body %}
    <div id="root"></div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('build/runtime.js') }}" defer></script>
    <script src="{{ asset('build/app.js') }}" defer></script>
{% endblock %}
</body>
</html>
